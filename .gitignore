# Compiled AMD JS — generated via `grunt amd` from amd/src/*.js.
# Since cachejs=false / jsrev=-1 is your dev workflow, these are
# build artifacts, not source.
/amd/build/

# Node / Grunt tooling (used to compile amd/src -> amd/build)
/node_modules/
package-lock.json

# PHP dependency dirs, if you ever add any locally (e.g. testing)
/vendor/

# Temp files this plugin writes via make_temp_directory('qtype_excelformula')
# shouldn't ever land in the repo, but ignore stray local copies too
*.tmp

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local Moodle debug/config artifacts if you ever test inside this folder
config.php
